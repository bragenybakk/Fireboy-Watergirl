@startuml
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam classFontStyle bold
hide empty members

interface ControllableGameModel {
    +clockTick()
    +movePlayerLeft()
    +movePlayerRight()
    +playerJump()
    +menuSelect()
}

interface ViewableGameModel {
    +getGameState() : GameState
    +getPlayers() : List<Player>
    +getBoard() : Board
    +getWinFadeProgress() : double
}

interface Theme {
    +getPlayerHead(ElementState) : BufferedImage
    +getDoor() : BufferedImage
    +getOpenDoor() : BufferedImage
    +getGem(ElementState) : BufferedImage
    +getPoolColor(ElementState) : Color
}

class GameController {
    -model : ControllableGameModel
    -timer : Timer
    +keyPressed(KeyEvent)
    +clockTick()
}

class GameModel {
    -board : Board
    -players : List<Player>
    -entities : List<StaticEntity>
    -enemies : List<IEnemy>
    -gameState : GameState
    +clockTick()
    +loadLevel(name : String)
    +movePlayerLeft()
    +playerJump()
}

class GameView {
    -theme : Theme
    -model : ViewableGameModel
    +paintComponent(Graphics)
}

abstract class StaticEntity {
    #pos : Position
    #width : double
    #height : double
    +whenContact(IMovable)
    #{abstract} contactAction(IMovable, CollisionSide)
}

class Player {
    -element : ElementState
    -alive : boolean
    +kill()
    +isOnGround() : boolean
}

class Enemy {
    -state : EnemyState
    +update()
    +isAlive() : boolean
}

GameController --> ControllableGameModel : uses
GameView --> ViewableGameModel : reads
GameView --> Theme : uses
GameModel ..|> ControllableGameModel
GameModel ..|> ViewableGameModel

GameModel "1" *-- "*" Player
GameModel "1" *-- "*" Enemy
GameModel "1" *-- "*" StaticEntity

note bottom of StaticEntity
  Subklasser:
  Wall, Door, Box, Pool, Gem,
  Button,
  BoostPlatform, MovingPlatform
end note

@enduml
